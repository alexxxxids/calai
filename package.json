    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "ical-generator": "^11.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "node-ical": "^0.27.2",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
