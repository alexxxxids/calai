# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Google AI Studio → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=

# Any 32+ random characters, e.g. from: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CRON_SECRET=

# Where the app runs: http://localhost:3000 locally, your Vercel URL in production
APP_URL=http://localhost:3000

# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
